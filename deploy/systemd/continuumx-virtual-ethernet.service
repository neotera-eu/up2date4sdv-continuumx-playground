[Unit]
Description=ContinuumX Virtual Ethernet Automotive ECU Mapper
Documentation=https://github.com/kubeedge/mapper-framework
Wants=edgecore.service
After=edgecore.service network-online.target

[Service]
Type=simple
User=root
Group=root

WorkingDirectory=/opt/continuumx/virtual-ethernet

ExecStartPre=/usr/bin/test -S /etc/kubeedge/dmi.sock

ExecStart=/opt/continuumx/virtual-ethernet/virtual-ethernet --config-file=/etc/continuumx/virtual-ethernet/config.yaml --v=2

Restart=always
RestartSec=10

TimeoutStopSec=15
KillSignal=SIGINT

StandardOutput=journal
StandardError=journal
SyslogIdentifier=continuumx-virtual-ethernet

[Install]
WantedBy=multi-user.target
