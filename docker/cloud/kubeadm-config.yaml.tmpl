# Kubernetes init config for the cloud node.
#
# You may change:
# - kubernetesVersion (keep in sync with packages in the cloud Dockerfile)
# - podSubnet / serviceSubnet
# - node name (u2deb-cloud) and controlPlaneEndpoint
# - __ADVERTISE_IP__ is filled at boot with the container IP (do not hardcode)

apiVersion: kubeadm.k8s.io/v1beta4
kind: InitConfiguration
localAPIEndpoint:
  advertiseAddress: "__ADVERTISE_IP__"
  bindPort: 6443
nodeRegistration:
  criSocket: unix:///run/containerd/containerd.sock
  name: u2deb-cloud
---
apiVersion: kubeadm.k8s.io/v1beta4
kind: ClusterConfiguration
kubernetesVersion: "v1.32.13"
controlPlaneEndpoint: "u2deb-cloud:6443"
apiServer:
  certSANs:
    - "u2deb-cloud"
    - "cloud"
    - "__ADVERTISE_IP__"
    - "127.0.0.1"
    - "localhost"
networking:
  podSubnet: "10.244.0.0/16"
  serviceSubnet: "10.96.0.0/12"
---
apiVersion: kubelet.config.k8s.io/v1beta1
kind: KubeletConfiguration
cgroupDriver: systemd
failSwapOn: false
featureGates:
  KubeletInUserNamespace: true
---
apiVersion: kubeproxy.config.k8s.io/v1alpha1
kind: KubeProxyConfiguration
mode: iptables
conntrack:
  maxPerCore: 0
  min: 0
  tcpCloseWaitTimeout: 0s
  tcpEstablishedTimeout: 0s
