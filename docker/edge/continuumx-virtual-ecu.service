[Unit]
Description=ContinuumX Virtual Thermal ECU Firmware Simulator
Documentation=https://github.com/neotera-eu/up2date4sdv-continuumx-playground
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=root
Group=root
RuntimeDirectory=continuumx-virtual-ecu
RuntimeDirectoryMode=0755
StateDirectory=continuumx-virtual-ecu
StateDirectoryMode=0700
EnvironmentFile=-/etc/continuumx/firmware-catalog.env
# Catalog is the only firmware source. Fetch boot baseline only when no active
# binary exists yet (skip on later restarts so OTA to sim-1.1.0 is preserved).
ExecStartPre=/bin/bash -c 'test -x /opt/continuumx/virtual-thermal-ecu/virtual-thermal-ecu || /usr/local/libexec/continuumx/fetch-ecu-from-catalog.sh sim-1.0.0 --install-active'
ExecStart=/opt/continuumx/virtual-thermal-ecu/virtual-thermal-ecu --socket /run/continuumx-virtual-ecu/ecu.sock --state-file /var/lib/continuumx-virtual-ecu/state.json
Restart=always
RestartSec=3
KillSignal=SIGTERM
TimeoutStartSec=180
TimeoutStopSec=10
StandardOutput=journal
StandardError=journal
SyslogIdentifier=continuumx-virtual-ecu

[Install]
WantedBy=multi-user.target
